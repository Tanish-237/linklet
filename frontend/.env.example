# Copy this file to .env and fill in real values for local development.
# Vite only exposes variables prefixed with VITE_ to client code.

# Backend API origin (no trailing slash, no /api/v1 suffix — that's appended
# by src/api/apiClient.js and backend/socket.js callers)
VITE_API_BASE_URL=http://localhost:5001

# Must match the backend's GOOGLE_CLIENT_ID for Google sign-in to work
VITE_GOOGLE_CLIENT_ID=
