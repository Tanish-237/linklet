<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static public routes only. Dynamic per-record pages (posts/:postId,
  question/:questionId, profile/:username, etc.) are intentionally omitted —
  they're user-generated, change constantly, and aren't enumerable at build
  time; a real sitemap for those would need to be generated server-side from
  the database, which is a separate, bigger piece of work.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://linklet.org/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://linklet.org/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://linklet.org/contact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://linklet.org/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://linklet.org/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://linklet.org/posts</loc>
    <changefreq>daily</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
