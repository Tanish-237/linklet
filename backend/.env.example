# Copy this file to .env and fill in real values. Never commit the real .env —
# it's already covered by .gitignore.

# ── Server ───────────────────────────────────────────────────────────────────
# On Vercel, set these in Project Settings → Environment Variables (PORT is
# ignored there; NODE_ENV is set to production automatically).
PORT=5001
NODE_ENV=development
# Your deployed frontend origin (used by CORS as a fallback allow-list entry
# alongside the hardcoded linklet.org / *.vercel.app rules in src/utils/cors.js)
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/linklet
# Database name, if not in the URL. Production uses "test"; Vercel previews use
# "linklet_preview" so they never touch live data.
MONGO_DB_NAME=

# ── Redis (required for OTP, sessions/logout, caching, socket.io scaling) ────
# Without this the app falls back to in-memory / no-op behavior for those
# features — fine for a quick local check, not for anything resembling production.
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# ── Google OAuth (institutional sign-in) ─────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Cloudinary (media storage for posts, resources, chat attachments) ───────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (OTP + contact form delivery) ──────────────────────────────────────
# Brevo transactional email API, the only provider. In Brevo, turn OFF
# "Authorised IPs" blocking: Vercel's outgoing IPs change. Locally, leave the
# key empty and emails are printed to the console instead of sent.
BREVO_API_KEY=
# Sender address verified in Brevo
EMAIL_FROM=
# Where contact-form submissions are delivered (defaults to founderslinklet@gmail.com)
CONTACT_RECEIVER_EMAIL=

# ── Gemini (AI timetable parsing) ────────────────────────────────────────────
GEMINI_API_KEY=
