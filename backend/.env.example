# Copy this file to .env and fill in real values. Never commit the real .env —
# it's already covered by .gitignore.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
# Your deployed frontend origin (used by CORS as a fallback allow-list entry
# alongside the hardcoded linklet.org / *.vercel.app rules in src/utils/cors.js)
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/linklet

# ── Redis (required for OTP, sessions/logout, caching, socket.io scaling) ────
# Without this the app falls back to in-memory / no-op behavior for those
# features — fine for a quick local check, not for anything resembling production.
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# ── Google OAuth (institutional sign-in) ─────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Cloudinary (media storage for posts, resources, chat attachments) ───────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (OTP + contact form delivery) ──────────────────────────────────────
# Primary: Brevo transactional email API (works on hosts that block outbound
# SMTP, e.g. Render's free tier). Any ONE of these three names is read.
BREVO_API_KEY=
# Fallback: Gmail SMTP via nodemailer, used only if no Brevo key is set.
EMAIL_USER=
EMAIL_PASS=
# Where contact-form submissions are delivered (defaults to EMAIL_USER's
# address if unset).
CONTACT_RECEIVER_EMAIL=

# ── Gemini (AI timetable parsing) ────────────────────────────────────────────
GEMINI_API_KEY=
